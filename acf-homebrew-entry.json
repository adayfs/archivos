{
  "acf-field-group": {
    "key": "group_homebrew_entry",
    "title": "Homebrew – Entradas",
    "fields": [
      {
        "key": "field_hb_campaign",
        "label": "Campaña",
        "name": "campaign",
        "type": "post_object",
        "post_type": ["campaign"],
        "return_format": "id",
        "multiple": false,
        "required": true
      },
      {
        "key": "field_hb_section",
        "label": "Sección",
        "name": "homebrew_section",
        "type": "select",
        "choices": {
          "reglas": "Reglas",
          "monstruos": "Manual de Monstruos",
          "forja": "Forja",
          "tienda": "Tienda"
        },
        "required": true,
        "ui": true,
        "default_value": "reglas"
      },
      {
        "key": "field_hb_entry_images",
        "label": "Imágenes",
        "name": "entry_images",
        "type": "gallery",
        "return_format": "id",
        "preview_size": "medium"
      }
    ],
    "location": [
      [
        {
          "param": "post_type",
          "operator": "==",
          "value": "homebrew_entry"
        }
      ]
    ],
    "position": "normal",
    "style": "default",
    "label_placement": "top",
    "instruction_placement": "label",
    "description": ""
  }
}
